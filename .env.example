# Skopiuj do pliku .env.local i uzupełnij (Supabase -> Project Settings -> API).
# Bez tych wartości gra działa w TRYBIE LOKALNYM (dwie karty w tej samej przeglądarce).
VITE_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
# Klucz publiczny: "publishable" (sb_publishable_...) albo starszy "anon". NIGDY nie wpisuj tu klucza secret/service_role!
VITE_SUPABASE_KEY=sb_publishable_xxx
